# Copie para .env e preencha o que for necessário.

# --- Segurança ---
# Obrigatório em produção: gere com `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Em dev, se vazio, um default é usado (nunca use o default em produção).
JWT_SECRET=dev-secret-change-me

# --- Cookie de sessão (HttpOnly) ---
# SameSite=None + Secure funcionam em https e em http://localhost.
# Em LAN local via IP (http://192.168.x.x), use COOKIE_SECURE=false e
# COOKIE_SAMESITE=lax, senão o navegador rejeita o cookie.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- Banco ---
# SQLite local (MVP). Em producao use Postgres, ex.:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco
DATABASE_URL=sqlite:///./tcgvault.db

# --- Google OAuth (opcional no dev) ---
# Sem estas variáveis, o back opera em MODO DEV (login mock, aviso claro).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Front ---
FRONTEND_URL=http://localhost:4200

# --- OCR: google | tesseract | none ---
OCR_PROVIDER=none
# Chave da API do Google Cloud Vision (usada se OCR_PROVIDER=google)
GOOGLE_API_KEY=

# --- Scryfall ---
SCRYFALL_BASE=https://api.scryfall.com
