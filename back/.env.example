# Copie para .env e preencha o que for necessário.

# --- Segurança ---
# Troque em produção. Em dev, o default serve.
JWT_SECRET=dev-secret-change-me

# --- Banco ---
# SQLite local (MVP). Migra para Postgres depois.
DATABASE_URL=sqlite:///./tcgvault.db

# --- Google OAuth (opcional no dev) ---
# Sem estas variáveis, o back opera em MODO DEV (login mock, aviso claro).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Front ---
FRONTEND_URL=http://localhost:4200

# --- OCR: google | tesseract | none ---
OCR_PROVIDER=none
# Chave da API do Google Cloud Vision (usada se OCR_PROVIDER=google)
GOOGLE_API_KEY=

# --- Scryfall ---
SCRYFALL_BASE=https://api.scryfall.com
